/**
 * 事件处理模块
 */
declare class EventEmitter<EventMap extends Record<string, any>> {
    /**
     * 监听指定的事件。
     * @param type - 监听的事件类型，是个字符串。
     * @param listener - 监听到事件类型后的处理函数。
     */
    on<K extends keyof EventMap>(type: K, listener: (event: EventMap[K]) => void): void;
    /**
     * 与 on 的区别是仅触发一次。
     * @param type - 监听的事件类型，是个字符串。
     * @param listener - 监听到事件类型后的处理函数。
     */
    once<K extends keyof EventMap>(type: K, listener: (event: EventMap[K]) => void): void;
    /**
     * 移除找到的第一个 listener。
     * @param type - 要移除的事件类型。
     * @param listener - 要移除的事件处理函数。
     */
    remove<K extends keyof EventMap>(type: K, listener: (event: EventMap[K]) => void): void;
    /**
     * 移除找到的所有 listener，不传则移除事件下所有。
     * @param type - 要移除的事件类型。
     * @param listener - 可选，要移除的事件处理函数。
     */
    removeAll<K extends keyof EventMap>(type?: K, listener?: (event: EventMap[K]) => void): void;
    /**
     * 与 on 是同一个方法，只是方法名不同。
     * @param type - 监听的事件类型，是个字符串。
     * @param listener - 监听到事件类型后的处理函数。
     */
    add<K extends keyof EventMap>(type: K, listener: (event: EventMap[K]) => void): void;
    /**
     * 与 remove 是同一个方法，只是方法名不同。
     * @param type - 要移除的事件类型。
     * @param listener - 要移除的事件处理函数。
     */
    off<K extends keyof EventMap>(type: K, listener: (event: EventMap[K]) => void): void;
    /**
     * 触发指定的事件
     */
    emit<K extends keyof EventMap>(type: K, event: EventMap[K]): void;
}

declare const FormData: typeof globalThis.FormData;
declare const Math: globalThis.Math;
declare const Date: typeof globalThis.Date;
type ClientConsole = Pick<Console, 'log' | 'error' | 'assert' | 'info' | 'warn' | 'clear'>;
declare const console: ClientConsole;
/**
 * 用于延迟执行函数的计时器，delayMs毫秒后异步执行回调函数callback。
 * 该函数自身是同步的，返回用于清除此计时器的ID，可在 clearTimeout 中使用。
 * @param callback - 要延迟执行的回调函数。
 * @param delayMs - 延迟的毫秒数。
 * @returns 用于清除计时器的ID。
 */
declare function setTimeout(callback: Function, delayMs: number): number;
/**
 * 用于清除传入ID对应的 setTimeout 计时器。
 * @param id - 要清除的计时器的ID。
 */
declare function clearTimeout(id: number): void;
/**
 * 用于定时执行函数的计时器，每 delayMs 毫秒后异步执行回调函数 callback。
 * 该函数自身是同步的，返回用于清除此计时器的ID，可在 clearInterval 中使用。
 * @param callback - 要定时执行的回调函数。
 * @param delayMs - 间隔的毫秒数。
 * @returns 用于清除计时器的ID。
 */
declare function setInterval(callback: Function, delayMs: number): number;
/**
 * 用于清除传入ID对应的 setInterval 计时器。
 * @param id - 要清除的计时器的ID。
 */
declare function clearInterval(id: number): void;
declare enum MediaErrorCode {
    MEDIA_ERR_ABORTED = 1,
    MEDIA_ERR_NETWORK = 2,
    MEDIA_ERR_DECODE = 3,
    MEDIA_ERR_SRC_NOT_SUPPORTED = 4
}
/**
 * 客户端脚本音频用于构建error对象（不是浏览器自己的MediaError）
 * see: https://developer.mozilla.org/en-US/docs/Web/API/MediaError
 */
declare class MediaError {
    code: MediaErrorCode;
    message: string;
    constructor(code: MediaErrorCode, message: string);
}
interface AudioEvent {
    target: Audio;
}
type AudioEventMap = {
    ended: AudioEvent;
    loadeddata: AudioEvent;
    error: AudioEvent;
};
declare class Audio extends EventEmitter<AudioEventMap> {
    src: string;
    volume: number;
    error: MediaError | null;
    load(): void;
    play(): Promise<void>;
    pause(): void;
}

interface ClientHttp {
    fetch: (url: string, options?: RequestInit) => Promise<Response>;
}
/**
 * @internal 仅供内部项目使用
 */
declare const http: ClientHttp;

/**
 * 指针锁定状态变化事件。
 */
type PointerLockChangeEvent = {
    /**
     * 表示指针是否锁定。
     */
    isLocked: boolean;
};
/**
 * 玩家指针锁定状态变化或出错时产生的事件。
 */
type PointerLockEvents = {
    pointerlockchange: PointerLockChangeEvent;
    pointerlockerror: undefined;
};

declare class Coord2 {
    readonly offset: Vec2;
    readonly scale: Vec2;
    /**
     * @param args 绑定内部数据相关的依赖，不在脚本中定义
     * @ignore
     */
    constructor(...args: any);
    static create(val?: Coord2): Coord2;
}
declare class Vec2 {
    x: number;
    y: number;
    /**
     * @param args 绑定内部数据相关的依赖，不在脚本中定义
     * @ignore
     */
    constructor(...args: any);
    copy(val: Vec2): void;
    static create(val?: Vec2): Vec2;
}
declare class Vec3 {
    x: number;
    y: number;
    z: number;
    r: number;
    g: number;
    b: number;
    /**
     * @param args 绑定内部数据相关的依赖，不在脚本中定义
     * @ignore
     */
    constructor(...args: any);
    copy(val: Vec3): void;
    static create(val?: Vec3): Vec3;
}

interface UiEvent {
    target: UiNode;
}
interface UiInputEvent {
    target: UiInput;
}
interface UiImageEvent {
    target: UiImage;
}
type UiNodeEvents = {
    pointerdown: UiEvent;
    pointerup: UiEvent;
};
type UiInputEvents = UiNodeEvents & {
    focus: UiInputEvent;
    blur: UiInputEvent;
};
type UiImageEvents = UiNodeEvents & {
    load: UiImageEvent;
};
/**
 * 基础节点
 */
declare class UiNode {
    name: string;
    readonly children: ReadonlyArray<UiNode>;
    parent: UiNode | undefined;
    /**
     * @ignore
     */
    constructor(...args: any);
    findChildByName: (name: string) => UiNode | undefined;
    /**
     * 管理节点相关的事件
     */
    events: EventEmitter<UiNodeEvents>;
    /**
     * 对节点进行缩放
     */
    uiScale: UiScale | undefined;
    /**
     * 克隆节点
     */
    clone: () => this;
}
declare class UiRenderable extends UiNode {
    readonly anchor: Vec2;
    readonly position: Coord2;
    readonly backgroundColor: Vec3;
    backgroundOpacity: number;
    readonly size: Coord2;
    zIndex: number;
    autoResize: 'NONE' | 'X' | 'Y' | 'XY';
    visible: boolean;
    pointerEventBehavior: PointerEventBehavior;
    /**
     * 旋转（角度）
     */
    rotation: number;
}
declare class UiBox extends UiRenderable {
    /**
     * @ignore
     */
    constructor(...args: any);
    static create(): UiBox;
}
declare enum UITextFontFamily {
    /**
     * 默认字体
     */
    Default = 0,
    /**
     * 粗圆体
     */
    BoldRound = 1,
    /**
     * Code New Roman Bold
     */
    CodeNewRomanBold = 2,
    /**
     * EN-Serif
     */
    ENSerif = 3
}
declare class BaseUiText extends UiRenderable {
    textContent: string;
    textFontSize: number;
    readonly textColor: Vec3;
    textXAlignment: 'Center' | 'Left' | 'Right';
    textYAlignment: 'Center' | 'Top' | 'Bottom';
    autoWordWrap: boolean;
    textLineHeight: number;
    readonly textStrokeColor: Vec3;
    textStrokeOpacity: number;
    textStrokeThickness: number;
    textFontFamily: UITextFontFamily;
}
declare class UiText extends BaseUiText {
    richText: boolean;
    static create(): UiText;
}
declare class UiInput extends BaseUiText {
    placeholder: string;
    readonly placeholderColor: Vec3;
    readonly placeholderOpacity: number;
    readonly isFocus: boolean;
    readonly focus: () => void;
    readonly blur: () => string;
    static create(): UiInput;
}
declare class UiScreen extends UiNode {
    visible: boolean;
    zIndex: number;
    static create(): UiScreen;
    /**
     * @version 2024.22
     */
    static getAllScreen(): UiScreen[];
}
declare class UiImage extends UiRenderable {
    image: string;
    imageOpacity: number;
    imageDisplayMode: ImageDisplayMode;
    readonly complete: boolean;
    static create(): UiImage;
}
/**
 * 图片展示方式
 */
declare enum ImageDisplayMode {
    /**
     * 铺满：（默认）适配元素外框长宽拉伸铺满展示，图片可能会变形
     */
    Fill = 0,
    /**
     * 等比铺满：等比缩放保证图片完整展示在外框内
     */
    Contain = 1,
    /**
     * 等比截取：等比缩放图片使图片填满外框，超出部分将被裁剪（隐藏显示）
     */
    Cover = 2,
    /**
     * 无：按图片正常尺寸与外框中心对齐展示，不对图片进行任何缩放调整，但是超出元素框部分会被裁剪（隐藏显示）
     */
    None = 3
}
/**
 * 滚动框
 */
declare class UiScrollBox extends UiRenderable {
    /**
     * 滚动的位置，设置后，会受到当前可滚动范围约束
     */
    readonly scrollPosition: Vec2;
    static create(): UiScrollBox;
}
declare class UiComponent {
    /**
     * @ignore
     */
    constructor(...args: any);
}
declare class UiScale extends UiComponent {
    scale: number;
    static create(): UiScale;
}
/**
 * 指针事件行为
 */
declare enum PointerEventBehavior {
    /**
     * 不响应，且不允许位于元素后方的其他元素响应。
     */
    DISABLE_AND_BLOCK_PASS_THROUGH = 0,
    /**
     * 不响应。
     */
    DISABLE = 1,
    /**
     * 不允许位于元素后方的其他元素响应。
     */
    BLOCK_PASS_THROUGH = 2,
    /**
     * 正常响应。
     */
    ENABLE = 3
}
/**
 * 游戏屏幕的宽度，取决于玩家进入游戏时的屏幕大小。
 */
declare const screenWidth: number;
/**
 * 游戏屏幕的高度，取决于玩家进入游戏时的屏幕大小。
 */
declare const screenHeight: number;
/**
 * @deprecated
 */
declare const ui: UiNode;

/**
 * 全局监听玩家的输入。
 */
declare class InputSystem {
    /**
     * 全局监听玩家指针与UI元素交互时的产生的事件。
     */
    readonly uiEvents: EventEmitter<UiNodeEvents>;
    /**
     * 全局监听当玩家指针锁定状态变化或出错时产生的事件。
     */
    readonly pointerLockEvents: EventEmitter<PointerLockEvents>;
    /**
     * @param args - 绑定数据时传入的参数。
     * @ignore
     */
    constructor(...args: any);
    /**
     * 调用后解锁指针。
     */
    unlockPointer(): void;
    /**
     * 调用后锁定指针，由于浏览器限制，此操作可能会失败。
     * 有兴趣可以查看https://w3c.github.io/pointerlock/#dom-element-requestpointerlock。
     */
    lockPointer(): void;
}
/**
 * 全局监听玩家的输入。
 */
declare const input: InputSystem;

interface ClientMedia {
    startRecording: () => Promise<void>;
    stopRecording: () => Promise<Blob>;
    /**
     * @param spec.blob 音频blob
     * @param spec.gain 音频增益量，同gainNode.gain.value
     */
    playAudio: (spec?: {
        blob?: Blob;
        gain?: number;
    }) => Promise<void>;
    stopPlayAudio: () => void;
}
declare const media: ClientMedia;

declare enum DeviceType {
    Desktop = "Desktop",
    Mobile = "Mobile"
}
type DeviceInfo = {
    deviceType: DeviceType;
    screen: {
        width: number;
        height: number;
    };
};
declare class ClientNavigator {
    getDeviceInfo: () => {
        deviceType: DeviceType;
        screen: {
            width: number;
            height: number;
        };
    };
    userAgent: string;
    language: string;
    /**
     * @ignore
     * @param getDeviceInfo
     * @param userAgent
     */
    constructor(getDeviceInfo: () => {
        deviceType: DeviceType;
        screen: {
            width: number;
            height: number;
        };
    }, userAgent: string, language: string);
}
declare const navigator: ClientNavigator;

type ClientRemoteChannelEvents = {
    client: any;
};
declare class ClientRemoteChannel {
    /**
     * @ignore
     */
    constructor(...args: any);
    /**
     * 向服务端发送服务端事件。
     */
    sendServerEvent: (event: any) => void;
    /**
     * 监听服务端发来的ClientEvent。
     */
    readonly events: EventEmitter<ClientRemoteChannelEvents>;
}
declare const remoteChannel: ClientRemoteChannel;

type ScreenResizeEvent = {
    screenWidth: number;
    screenHeight: number;
};
type ScreenEvents = {
    resize: ScreenResizeEvent;
};
declare class ClientScreen {
    readonly events: EventEmitter<ScreenEvents>;
    onResize(evt: ScreenResizeEvent): void;
}
declare const screen: ClientScreen;

interface WritableProperty<T> extends PropertyDescriptor {
    get(): T;
    set(value: unknown): void;
}
/**
 * 代表客户端上的游戏世界
 */
declare class ClientWorld {
    /**
     * 控制是否渲染3D场景。
     * 当关闭时，3D 场景的渲染将在客户端暂停，画面会停留在最后一次渲染的状态。
     * 2D UI 不受此属性影响，除 3D 渲染外的客户端行为不受此属性影响。
     * @example
     * const renderingBtn = ui.findChildByName('rendering3d');
     * renderingBtn.events.on('pointerdown', () => {
     *    console.info('Rendering switch!');
     *    world.rendering3d = !world.rendering3d;
     * })
     */
    rendering3d: boolean;
    /**
     * @ignore
     */
    constructor(rendering3d: WritableProperty<boolean>);
}
declare const world: ClientWorld;

/**
 * 不属于任何模块的全局变量和函数。
 * @module Client
 */

/**
 * 延迟指定毫秒后返回一个resolve的Promise对象。
 * @param ms - 延迟的毫秒数。
 * @returns 一个Promise，在指定的毫秒数后resolve。
 * @example
 *
 * // 返回Promise，有两种基本用法
 * // #1
 *
 * sleep(1000).then(() => {
 *   console.log('这句话将在一秒后输出。')
 * })
 *
 * // #2
 *
 * (async () => {
 *     await sleep(1000);
 *     console.log('这句话将在一秒后输出。')
 * })();
 */
declare function sleep(ms: number): Promise<void>;
/**
 * 仅在 Webview 中 callback 生效
 */
declare function call(key: string, value: any, callback?: () => void): any;
declare function callAsync(key: string, value: any): Promise<any>;
