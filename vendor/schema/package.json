  },
  "dependencies": {
    "@box/mudb": "workspace:*",
    "@box/script-api": "workspace:*",
    "@box/utils": "workspace:*",
    "debug": "4.3.4",
    "gl-matrix": "3.4.3",
    "pino": "8.19.0"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
