{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2017",
    "lib": ["dom", "es6", "es2015", "es5", "es2017"],

    "downlevelIteration": true,
    "declaration": true,
    "sourceMap": false,

    "noImplicitReturns": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "alwaysStrict": false,
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "rootDir": "./src",
    "outDir": "./build"
  },
  "include": ["src/**/*.ts"]
}
