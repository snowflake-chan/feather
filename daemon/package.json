{
  "name": "@feather/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "feather 本地管理面（Docker-like）契约；目前只含类型",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": ["dist/contract.d.ts"],
      "*": ["dist/*"]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "feather-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
