{
  "name": "@feather/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "feather \u672c\u5730\u7ba1\u7406\u9762\uff08Docker-like\uff09\u5951\u7ea6\uff1b\u76ee\u524d\u53ea\u542b\u7c7b\u578b",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "*": [
        "dist/*"
      ],
      "main": [
        "dist/main.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:shard": "node dist/check-shard.js",
    "check:shard-policy": "node dist/check-shard-policy.js",
    "check:map-config": "node dist/check-map-config.js",
    "check:volume": "node dist/check-volume.js",
    "check:stats": "node dist/check-stats.js",
    "check:daemon": "node dist/check-daemon.js",
    "check:content-arena": "node dist/check-content-arena.js",
    "check:restart": "node dist/check-restart.js"
  },
  "dependencies": {
    "feather-engine": "workspace:*",
    "@feather/transport": "workspace:*",
    "@feather/builder": "workspace:*",
    "smol-toml": "1.3.4"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "20.16.15"
  },
  "bin": {
    "feather-daemon": "bin/feather-daemon"
  }
}
