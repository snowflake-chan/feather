{
  "name": "@feather/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "feather 本地管理面（Docker-like）契约；目前只含类型",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "require": "./dist/contract.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract.d.ts"
      ],
      "*": [
        "dist/*"
      ],
      "main": [
        "dist/main.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:shard": "node dist/check-shard.js",
    "check:shard-policy": "node dist/check-shard-policy.js",
    "check:map-config": "node dist/check-map-config.js",
    "check:stats": "node dist/check-stats.js",
    "check:daemon": "node dist/check-daemon.js"
  },
  "dependencies": {
    "feather-engine": "workspace:*",
    "@feather/transport": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "20.16.15"
  },
  "bin": {
    "feather-daemon": "bin/feather-daemon"
  }
}
