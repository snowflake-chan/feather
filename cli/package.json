{
  "name": "@feather/cli",
  "version": "0.0.0",
  "private": true,
  "description": "feather workspace CLI",
  "bin": {
    "feather": "bin/feather"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:maps": "node dist/check-maps.js",
    "check:build": "node dist/check-build.js"
  },
  "devDependencies": {
    "@types/node": "20.16.15",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@feather/daemon": "workspace:*",
    "smol-toml": "1.3.4"
  }
}
