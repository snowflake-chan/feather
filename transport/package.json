{
  "name": "@feather/transport",
  "version": "0.0.0",
  "private": true,
  "description": "engine 与 shell 之间的 Node worker_threads 传输层",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@box/mudb": "workspace:*",
    "@box/schema": "workspace:*",
    "@box/utils": "workspace:*",
    "@feather/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "20.16.15"
  }
}
