{
  "info": {
    "name": "Feather Daemon API",
    "description": "Feather local daemon API over Unix domain socket. Import this collection, set the daemonSocket collection variable, then send /_ping.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "daemonSocket",
      "value": "/tmp/feather-ws/.feather/daemon.sock"
    },
    {
      "key": "mapId",
      "value": "cloud-4e84ee7ef626058f-imported"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/_ping",
            "description": "Liveness. Returns OK."
          }
        },
        {
          "name": "version",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/version"
          }
        },
        {
          "name": "info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/info"
          }
        }
      ]
    },
    {
      "name": "Maps",
      "item": [
        {
          "name": "list maps",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps"
          }
        },
        {
          "name": "get map",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}"
          }
        },
        {
          "name": "create map",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://unix:{{daemonSocket}}:/v1/maps",
            "description": "Create a map. Replace ABS and projectHash with real paths/hash.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"my-map\",\n  \"name\": \"My Map\",\n  \"projectStatePath\": \"/ABS/workspace/maps/group/worlds/my-map/data/project-state.json\",\n  \"contentDir\": \"/ABS/workspace/maps/group/worlds/my-map/data/blobs\",\n  \"projectHash\": \"Qm...\",\n  \"port\": 0,\n  \"scriptWorkerEntry\": \"/ABS/feather/shell/tools/worker-entry/worker-entry.js\",\n  \"databaseUrl\": \"sqlite:////ABS/workspace/.feather/sqlite/group.sqlite\",\n  \"groupNamespace\": \"group\",\n  \"dataStorageNamespace\": \"my-map\",\n  \"dataDir\": \"/ABS/workspace/.feather/data/my-map\",\n  \"contentId\": 100,\n  \"autoStart\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "start map",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}/start"
          }
        },
        {
          "name": "stop map",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}/stop"
          }
        },
        {
          "name": "restart map",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}/restart"
          }
        },
        {
          "name": "stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}/stats"
          }
        },
        {
          "name": "delete map",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}"
          }
        }
      ]
    },
    {
      "name": "Logs / Events",
      "item": [
        {
          "name": "logs tail 50",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}/logs?tail=50"
          }
        },
        {
          "name": "logs follow",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}/logs?follow=1&tail=10",
            "description": "NDJSON stream. Disconnect in Postman to stop."
          }
        },
        {
          "name": "events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/events"
          }
        }
      ]
    },
    {
      "name": "Daemon",
      "item": [
        {
          "name": "shutdown",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/shutdown"
          }
        }
      ]
    }
  ]
}
