{
  "info": {
    "name": "Feather Daemon API",
    "description": "Feather daemon API over Unix domain socket. Import this collection, set daemonSocket (and mapId/instanceId), then send /_ping. Maps are images; instances are containers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "daemonSocket",
      "value": "/tmp/feather-ws/.feather/daemon.sock"
    },
    {
      "key": "mapId",
      "value": "cloud-4e84ee7ef626058f-imported"
    },
    {
      "key": "instanceId",
      "value": "cloud-4e84ee7ef626058f-imported"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/_ping"
          }
        },
        {
          "name": "version",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/version"
          }
        },
        {
          "name": "info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/info"
          }
        },
        {
          "name": "shards",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/shards"
          }
        }
      ]
    },
    {
      "name": "Maps (definitions)",
      "item": [
        {
          "name": "list maps",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps"
          }
        },
        {
          "name": "get map",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}"
          }
        },
        {
          "name": "delete map (rmi)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/maps/{{mapId}}"
          }
        }
      ]
    },
    {
      "name": "Instances",
      "item": [
        {
          "name": "list instances",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances"
          }
        },
        {
          "name": "create instance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://unix:{{daemonSocket}}:/v1/instances",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mapId\": \"{{mapId}}\",\n  \"id\": \"{{instanceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "get instance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}"
          }
        },
        {
          "name": "start",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}/start"
          }
        },
        {
          "name": "stop",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}/stop"
          }
        },
        {
          "name": "restart",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}/restart"
          }
        },
        {
          "name": "stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}/stats"
          }
        },
        {
          "name": "delete instance (rm)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}"
          }
        }
      ]
    },
    {
      "name": "Logs / Events",
      "item": [
        {
          "name": "instance logs tail 50",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}/logs?tail=50"
          }
        },
        {
          "name": "instance logs follow",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/instances/{{instanceId}}/logs?follow=1&tail=10"
          }
        },
        {
          "name": "events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/events"
          }
        }
      ]
    },
    {
      "name": "Daemon",
      "item": [
        {
          "name": "shutdown",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://unix:{{daemonSocket}}:/v1/shutdown"
          }
        }
      ]
    }
  ]
}
