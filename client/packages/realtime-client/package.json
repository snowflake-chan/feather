{
  "name": "@box/realtime-client",
  "version": "0.1.0",
  "description": "Shared ticket-authenticated browser realtime subscriptions for BOX applications",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-reusable-package.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.cjs"
    ]
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "jest": "29.7.0",
    "typescript": "5.6.3"
  }
}
