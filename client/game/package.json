  "scripts": {
    "build": "npm run build-apis && npm run build-ipfs && npm run build-next",
    "build-apis": "node -r ts-node/register --max-old-space-size=4096 ./scripts/build-apis.ts",
    "build:script-types": "npm run build-apis && npm --prefix ../../packages/script-api run build && npm --prefix ../local-engine run prepare-assets && npm run test:script-types",
    "test:script-types": "node -r ts-node/register scripts/check-editor-types.ts",
    "build-ipfs": "ts-node -r tsconfig-paths/register ./scripts/build-ipfs.ts",
    "build-llm-context": "node -r ts-node/register --max-old-space-size=4096 ./scripts/build-llm-context.ts",
    "build-service-worker-cache": "node -r ts-node/register ./scripts/build-service-worker-cache-range.ts",
    "prebuild-next": "npm run build-service-worker-cache",
    "build-next": "NODE_ENV=production next build",
    "build-player:dev": "NODE_ENV=development webpack --config rusty/webpack.config.js",
    "build-player:prod": "NODE_ENV=production webpack --config rusty/webpack.config.js",
    "dev": "node -r ts-node/register --inspect server/dev-server/index.ts",
    "export": "NEXT_PUBLIC_EXPORT_MODE=true npm run build && NEXT_PUBLIC_EXPORT_MODE=true next export",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location .next/cache/eslint/.eslintcache",
    "test": "jest",
    "test:realtime": "npm --prefix ../../packages/realtime-client run build && npm --prefix ../../packages/realtime-client test && jest --runInBand --runTestsByPath server/creator-scene-websocket.test.ts server/realtime-tickets.test.ts server/realtime-session.test.ts server/request-websocket-protocol.test.ts shared/websocket-url.test.ts src/utils/remote-game-server.test.ts src/views/edit/components/nav-bar/right-control/scene-connection.test.ts --reporters=default",
    "test:realtime-postgres": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/regression-player-change-feed.ts",
    "test:local-runtime-session": "node -r ts-node/register scripts/regression-local-runtime-session.ts"
  },
  "browserslist": [
    "defaults"
  ],
