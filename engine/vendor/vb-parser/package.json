    "@box/vb": "workspace:0.1.0",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "28.0.3",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/ndarray": "1.0.11",
    "gl-matrix": "3.4.3",
    "nanoid": "3.3.18",
    "ndarray": "1.0.19",
    "rollup": "4.59.0",
    "tslib": "2.3.1",
    "typescript": "5.6.3"
